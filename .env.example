# Copia este archivo como .env y ajusta los valores si lo necesitas.
# Si no creas un .env, docker-compose usa estos mismos valores por defecto.

# Puerto donde se abre la app en el navegador → http://localhost:3000
APP_PORT=3000

# Puerto de la API (Swagger en http://localhost:8081/q/swagger-ui)
API_PORT=8081

# Credenciales de MongoDB (solo se aplican la PRIMERA vez que se crea el volumen)
MONGO_USER=studytracker
MONGO_PASSWORD=studytracker
MONGO_DATABASE=studytracker
MONGO_PORT=27018

# Zona horaria para calcular "hoy", las rachas y el mapa de calor.
# Lista de zonas: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Santo_Domingo
